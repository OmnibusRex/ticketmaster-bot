# Copy to .env and fill in. .env is gitignored.

# Ticketmaster account (optional if using accounts.yaml)
TM_EMAIL=you@example.com
TM_PASSWORD=your-password-here

# Captcha solvers
OPENAI_API_KEY=
OPENAI_CAPTCHA_MODEL=gpt-4o-mini
CAPSOLVER_API_KEY=

# Proxy (residential recommended)
# Full URL, e.g. http://user:pass@geo.iproyal.com:12321
PROXY_URL=
